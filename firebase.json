{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": ["firebase.json", ".git", ".git/**", "**/.*", "**/node_modules/**", "node_modules"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/academy.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/admin/**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
      { "source": "/r/**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
